#!/usr/bin/env nix-shell
#!nix-shell -i bash -p "python3.withPackages (ps: [ ps.pygobject3 ])" gobject-introspection glib gst_all_1.gstreamer gst_all_1.gst-plugins-base gst_all_1.gst-plugins-good gst_all_1.gst-plugins-bad gst_all_1.gst-plugins-ugly pipewire glib-networking
#
# Stream a specific window to RTMP(S) on GNOME/Wayland via the xdg-desktop-portal
# ScreenCast API (shows a picker dialog once; selection is persisted).
#
# Usage:
#   stream-window <profile>                    use ~/.config/stream-window/profiles.ini
#                                              (profile name may contain spaces —
#                                              it is drawn as the OSD text)
#   stream-window "<profile name>"             same, when the name has spaces
#   stream-window <rtmp-url> [x y w h] [kbps]  ad-hoc stream
#   stream-window --list                       list configured profiles
#   stream-window --edit                       open the GTK profile editor
#   stream-window --version                    print version
#
# Self-contained: on every run, missing support files are (re)installed
# into ~/.local/bin and ~/.config — the profiles.ini template, the argos
# tray widget, the GTK profile editor and stream-reset. A curl-downloaded
# copy of this file is all a fresh machine needs.
#
# Profile keys (ini): url, osd_font, osd_color, osd_outline,
#   osd_outline_width, osd_xpad, osd_ypad, crop, bitrate,
#   watch_proc, require_proc, start_cmd, encoder.
#   The OSD text is the profile name (spaces allowed).
#   Colors: names (white/black/...), #RGB, #RRGGBB, #RRGGBBAA,
#   or raw 0xAARRGGBB.  A [DEFAULT] section supplies values to all
#   profiles; a profile key overrides its [DEFAULT] counterpart.
#
# Env vars (override profile settings):
#   ENCODER=auto|va|x264   hardware VAAPI encoder (auto = va if available)
#   WATCH_PROC=pattern     exit when a process matching this pgrep -f ERE
#                          pattern dies; waits for it to appear if absent.
#                          Example: 'screenrec$' watches the tray app while
#                          ignoring the 'screenrec --card ...' daemon.
#   REQUIRE_PROC=pattern   refuse to start unless a process matching this
#                          pgrep -f ERE pattern is running; warns via a
#                          desktop notification (visible from tray launches)
#   START_CMD=command      if REQUIRE_PROC isn't running, run this first and
#                          wait up to 15s for the process to appear
#   RTMP_TRAILING_SLASH=1  append '/' to URL (never applied to '?' URLs)
#   OSD=text OSD_FONT=... OSD_COLOR=0xAARRGGBB OSD_OUTLINE=0x...
#   OSD_XPAD=px OSD_YPAD=px   overlay settings for ad-hoc (URL) mode
#
# First run on a fresh machine: the nix-shell shebang downloads all
# dependencies automatically, and the portal picker dialog appears ONCE --
# select the window, tick "Remember this selection", click Share. The
# persist token is saved to ~/.local/share/stream-window.token and all
# later runs skip the dialog entirely.
#
# Server defaults follow the docs: bitrate <= 2500k, 24 fps,
# GOP = 2*fps (key-int-max 48), B-frames off, rtmp2sink.
#
# Tray: while streaming, ~/.config/argos/stream.r.2s.sh shows the active
# profile from $XDG_RUNTIME_DIR/stream-window.state.
#
# Stop: kill $(cat /run/user/1000/stream-window.pid)

VERSION="0.1.0"

set -euo pipefail

# --- self-install support files (only when missing) -----------------------
BIN_DIR="$HOME/.local/bin"
CFG_DIR="$HOME/.config/stream-window"
mkdir -p "$BIN_DIR" "$CFG_DIR"

if [ ! -f "$CFG_DIR/profiles.ini" ]; then
    cat > "$CFG_DIR/profiles.ini" <<'INI_EOF'
# stream-window profiles — one [section] per profile.
#
# [DEFAULT] is not a profile: its values apply to every profile, and any
# profile can override them by setting the same key.
#
# Keys:
#   url            (required per profile) rtmp(s):// publish URL
#   OSD text       the profile name itself (spaces allowed)
#   osd_font       Pango font (default: Sans 16)
#   osd_color      text color (default: #FFFFFF22)
#   osd_outline    outline color (default: transparent = disabled)
#   osd_outline_width  outline thickness px (default: 1)
#   osd_xpad / osd_ypad  text padding px (default: 48 / 36)
#   crop           "x y w h" relative to window top-left
#   bitrate        kbps, recommended <= 2500 (default: 1800)
#   watch_proc     pgrep -f ERE pattern; stream exits when it dies
#   require_proc   pgrep -f ERE pattern; warn + don't start if absent
#   start_cmd      run this when require_proc is absent; wait ~15s for it
#   encoder        auto | va | x264
#
# colors: white black red green blue yellow cyan magenta orange gray
#         lightgray transparent | #RGB | #RRGGBB | #RRGGBBAA | 0xAARRGGBB
#
# Usage:  stream-window <profile>     (quote names containing spaces)
#         stream-window --list
#         stream-window --edit  (GUI editor)

[DEFAULT]
crop = 1150 220 2686 1938
bitrate = 1800
watch_proc = screenrec$
encoder = auto
osd_font = Sans 16
osd_color = #FFFFFF55
osd_outline = transparent
osd_outline_width = 1
osd_xpad = 48
osd_ypad = 1800

# Add profiles below — one [section] each (name = OSD text):
# [my stream]
# url = rtmps://host/app/STREAM_KEY
INI_EOF
    echo "installed $CFG_DIR/profiles.ini" >&2
fi

ARGOS="$HOME/.config/argos/stream.r.2s.sh"
if [ -d "$HOME/.config/argos" ] && [ ! -f "$ARGOS" ]; then
    cat > "$ARGOS" <<'ARGOS_EOF'
#!/bin/sh
# Argos widget: shows which stream-window profile is streaming.
# stream-window writes the active profile to $XDG_RUNTIME_DIR/stream-window.state

RTD="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$RTD/stream-window.state"
PROFILES="${STREAM_PROFILES:-$HOME/.config/stream-window/profiles.ini}"
EDIT="$HOME/.local/bin/stream-profiles-edit"
VER=$(sed -n 's/^VERSION="\(.*\)"/\1/p' "$HOME/.local/bin/stream-window" 2>/dev/null | head -1)

if [ -s "$STATE" ]; then
    echo "● STREAM: $(cat "$STATE") | color=#ff3333 font=monospace"
    echo "---"
    echo "Stop stream | bash='kill \$(cat $RTD/stream-window.pid)' terminal=false refresh=true"
else
    echo "stream: off | color=#888888 font=monospace"
    echo "---"
    if [ -f "$PROFILES" ]; then
        grep -oE '^\[[^]]+\]' "$PROFILES" | tr -d '[]' | grep -vxF 'DEFAULT' | while read -r p; do
            echo "Start: $p | bash='$HOME/.local/bin/stream-window \"$p\"' terminal=false refresh=true"
        done
    else
        echo "no profiles.ini | color=#888888"
    fi
fi
[ -x "$EDIT" ] && echo "Edit profiles… | bash='$EDIT' terminal=false"
[ -n "$VER" ] && echo "stream-window v$VER | font=monospace size=10 color=#888888 href=https://github.com/gruz/strumok"
ARGOS_EOF
    chmod +x "$ARGOS"
    echo "installed $ARGOS (tray widget)" >&2
elif [ ! -d "$HOME/.config/argos" ]; then
    echo "note: argos gnome extension not found — tray widget skipped" >&2
fi

if [ ! -f "$BIN_DIR/stream-profiles-edit" ]; then
    cat > "$BIN_DIR/stream-profiles-edit" <<'EDIT_EOF'
#!/usr/bin/env nix-shell
#!nix-shell -i bash -p "python3.withPackages (ps: [ ps.pygobject3 ])" gobject-introspection gtk3 glib
#
# stream-profiles-edit — GTK editor for ~/.config/stream-window/profiles.ini
# Self-installed by stream-window on first run.

set -euo pipefail
exec python3 - <<'PYEOF'
import configparser
import os
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gio, Gtk

INI = os.path.expanduser(os.environ.get(
    "STREAM_PROFILES", "~/.config/stream-window/profiles.ini"))

HEADER = """# stream-window profiles — one [section] per profile.
#
# [DEFAULT] is not a profile: its values apply to every profile, and any
# profile can override them by setting the same key.
#
# Keys:
#   url            (required per profile) rtmp(s):// publish URL
#   osd            text drawn on the stream (default: profile name in CAPS)
#   osd_font       Pango font (default: Sans 16)
#   osd_color      text color (default: #FFFFFF22)
#   osd_outline    outline color (default: transparent = disabled)
#   osd_outline_width  outline thickness px (default: 1)
#   osd_xpad / osd_ypad  text padding px (default: 48 / 36)
#   crop           "x y w h" relative to window top-left
#   bitrate        kbps, recommended <= 2500 (default: 1800)
#   watch_proc     pgrep -f ERE pattern; stream exits when it dies
#   require_proc   pgrep -f ERE pattern; warn + don't start if absent
#   start_cmd      run this when require_proc is absent; wait ~15s for it
#   encoder        auto | va | x264
#
# colors: white black red green blue yellow cyan magenta orange gray
#         lightgray transparent | #RGB | #RRGGBB | #RRGGBBAA | 0xAARRGGBB
"""

ADV_FIELDS = [
    ("osd_font", "OSD font"),
    ("osd_color", "OSD color"),
    ("osd_outline", "OSD outline"),
    ("osd_outline_width", "OSD outline width"),
    ("osd_xpad", "OSD xpad"),
    ("osd_ypad", "OSD ypad"),
    ("crop", "Crop (x y w h)"),
    ("bitrate", "Bitrate kbps"),
    ("watch_proc", "Watch process"),
    ("require_proc", "Require process"),
    ("start_cmd", "Start command"),
    ("encoder", "Encoder"),
]
FIELDS = [("url", "RTMP URL")] + ADV_FIELDS


class Editor(Gtk.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(title="Stream profiles", **kwargs)
        self.set_default_size(920, 460)
        self.set_border_width(8)
        self.dirty = False
        self.current = None

        cfg = configparser.ConfigParser()
        cfg.optionxform = str
        cfg.read(INI)
        self.data = {"DEFAULT": dict(cfg.defaults())}
        for s in cfg.sections():
            self.data[s] = dict(cfg[s])

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        # left: profile list
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.set_border_width(6)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-selected", self.on_select)
        scroll = Gtk.ScrolledWindow()
        scroll.set_size_request(160, -1)
        scroll.add(self.listbox)
        left.pack_start(scroll, True, True, 0)

        btnbox = Gtk.Box(spacing=6)
        badd = Gtk.Button(label="Add")
        badd.connect("clicked", self.on_add)
        bdel = Gtk.Button(label="Delete")
        bdel.connect("clicked", self.on_del)
        btnbox.pack_start(badd, True, True, 0)
        btnbox.pack_start(bdel, True, True, 0)
        left.pack_start(btnbox, False, False, 0)
        bdef = Gtk.Button(label="Defaults…")
        bdef.set_tooltip_text("Edit shared [DEFAULT] values")
        bdef.connect("clicked", self.on_defaults)
        left.pack_start(bdef, False, False, 0)
        paned.pack1(left, False, False)

        # right: primary fields (name + url), then Advanced expander
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.set_border_width(6)
        self.entries = {}

        top = Gtk.Grid(column_spacing=8, row_spacing=6)
        top.attach(Gtk.Label(label="Name", xalign=0), 0, 0, 1, 1)
        self.name_entry = Gtk.Entry()
        self.name_entry.set_hexpand(True)
        self.name_entry.set_placeholder_text("profile name = OSD text")
        self.name_entry.connect("changed", self.on_rename)
        top.attach(self.name_entry, 1, 0, 1, 1)
        self.url_label = Gtk.Label(label="RTMP URL", xalign=0)
        top.attach(self.url_label, 0, 1, 1, 1)
        ue = Gtk.Entry()
        ue.set_hexpand(True)
        ue.connect("changed", self.on_change)
        top.attach(ue, 1, 1, 1, 1)
        self.entries["url"] = ue
        top.attach(Gtk.Label(label="(name is drawn as the OSD text)",
                             xalign=0), 0, 2, 2, 1)
        right.pack_start(top, False, True, 0)

        self.exp = exp = Gtk.Expander(label="Advanced")
        exp.set_expanded(False)
        grid = Gtk.Grid(column_spacing=8, row_spacing=6)
        grid.set_border_width(4)
        for i, (key, label) in enumerate(ADV_FIELDS):
            l = Gtk.Label(label=label, xalign=0)
            e = Gtk.Entry()
            e.connect("changed", self.on_change)
            grid.attach(l, 0, i, 1, 1)
            grid.attach(e, 1, i, 1, 1)
            self.entries[key] = e
        exp.add(grid)
        right.pack_start(exp, True, True, 0)

        bbar = Gtk.Box(spacing=6)
        bsave = Gtk.Button(label="Save")
        bsave.get_style_context().add_class("suggested-action")
        bsave.connect("clicked", self.on_save)
        bsavec = Gtk.Button(label="Save and close")
        bsavec.connect("clicked", self.on_save_close)
        bbar.pack_start(bsave, True, True, 0)
        bbar.pack_start(bsavec, True, True, 0)
        right.pack_end(bbar, False, False, 0)
        self.status = Gtk.Label(label="", xalign=0)
        right.pack_end(self.status, False, False, 0)
        paned.pack2(right, True, False)
        self.right = right

        for name in self.data:
            if name != "DEFAULT":
                self.add_row(name)
        self.show_all()
        rows = self.listbox.get_children()
        if rows:
            self.listbox.select_row(rows[0])
        else:
            self.right.hide()

    def add_row(self, name):
        row = Gtk.ListBoxRow()
        row.add(Gtk.Label(label=name, xalign=0))
        row._name = name
        self.listbox.add(row)
        row.show_all()

    def _load(self, name):
        self.current = name
        self.right.show_all()
        vals = self.data.get(name, {})
        for key, e in self.entries.items():
            e.handler_block_by_func(self.on_change)
            e.set_text(str(vals.get(key, "")))
            e.handler_unblock_by_func(self.on_change)
        is_def = name == "DEFAULT"
        self.name_entry.handler_block_by_func(self.on_rename)
        self.name_entry.set_text("DEFAULT (shared)" if is_def else name)
        self.name_entry.set_sensitive(not is_def)
        self.name_entry.handler_unblock_by_func(self.on_rename)
        self.url_label.set_visible(not is_def)
        self.entries["url"].set_visible(not is_def)

    def on_select(self, lb, row):
        if row is None:
            return
        self.commit_current()
        self._load(row._name)

    def on_defaults(self, *_):
        self.commit_current()
        self.listbox.unselect_all()
        self._load("DEFAULT")
        self.exp.set_expanded(True)

    def commit_current(self):
        if not self.current:
            return
        vals = {k: e.get_text() for k, e in self.entries.items()
                if e.get_text() != ""}
        self.data[self.current] = vals

    def on_change(self, *_):
        self.commit_current()
        self.dirty = True

    def on_rename(self, entry):
        if not self.current or self.current == "DEFAULT":
            return
        new = entry.get_text().strip()
        if (not new or new == self.current or new in self.data
                or "[" in new or "]" in new or new == "DEFAULT"):
            return
        self.data[new] = self.data.pop(self.current)
        row = self.listbox.get_selected_row()
        row._name = new
        row.get_child().set_text(new)
        self.current = new
        self.dirty = True

    def on_add(self, *_):
        base = "profile"
        i = 1
        while f"{base}{i}" in self.data:
            i += 1
        name = f"{base}{i}"
        self.data[name] = {"url": ""}
        self.add_row(name)
        for r in self.listbox.get_children():
            if r._name == name:
                self.listbox.select_row(r)
        self.dirty = True

    def on_del(self, *_):
        row = self.listbox.get_selected_row()
        if not row or row._name == "DEFAULT":
            return
        del self.data[row._name]
        self.listbox.remove(row)
        self.current = None
        self.right.hide()
        self.dirty = True

    def on_save(self, *_):
        self.commit_current()
        out = [HEADER]
        for name, vals in self.data.items():
            out.append(f"[{name}]")
            out += [f"{k} = {v}" for k, v in vals.items()]
            out.append("")
        os.makedirs(os.path.dirname(INI), exist_ok=True)
        with open(INI, "w") as f:
            f.write("\n".join(out))
        self.dirty = False
        self.status.set_text(f"saved {INI}")

    def on_save_close(self, *_):
        self.on_save()
        self.close()


def apply_system_theme():
    """Use the dark GTK variant when GNOME prefers dark style."""
    try:
        s = Gio.Settings.new("org.gnome.desktop.interface")
        keys = s.get_property("settings-schema").list_keys()
        if "color-scheme" in keys:
            dark = s.get_string("color-scheme") == "prefer-dark"
        else:                            # GNOME < 42: no color-scheme key
            dark = "dark" in s.get_string("gtk-theme").lower()
        if dark:
            Gtk.Settings.get_default().set_property(
                "gtk-application-prefer-dark-theme", True)
    except Exception:
        pass


apply_system_theme()

app = Gtk.Application(application_id="strumok.profiles.edit")


def on_activate(a):
    w = a.get_active_window()
    if w:
        w.present()                  # editor already open: raise it
    else:
        Editor(application=a).present()


app.connect("activate", on_activate)
app.run()
PYEOF
EDIT_EOF
    chmod +x "$BIN_DIR/stream-profiles-edit"
    echo "installed $BIN_DIR/stream-profiles-edit" >&2
fi

if [ ! -f "$BIN_DIR/stream-reset" ]; then
    cat > "$BIN_DIR/stream-reset" <<'RESET_EOF'
#!/usr/bin/env bash
# stream-reset — restore the machine to "before stream-window ever ran",
# so first-run behavior (deps download, picker dialog, token persist) can
# be re-tested.
#
# Default mode resets RUNTIME + PERSISTED state only and keeps the
# installed files (stream-window, profiles.ini, argos widget).
# With --all it removes those files too (full uninstall).
#
# Currently covers state created by stream-window:
#   - running stream processes and their gst children
#   - $XDG_RUNTIME_DIR/stream-window.{pid,state}
#   - ~/.local/share/stream-window.token  (portal persist handle)
#   - ~/.local/share/flatpak/db/screencast (portal permission store entry)
#   - portal daemons restarted (they cache persist tokens in memory)
#   - ~/stream-window.log
#
# NOT covered: nix store caches (deps stay downloaded — harmless, a truly
# fresh machine downloads them once anyway) and the Devin Desktop install
# (~/.local/bin/devin-desktop, ~/.local/share/devin-desktop-libs,
# ~/.local/share/applications/devin-desktop.desktop) which is unrelated.
#
# Note: stream-window self-installs profiles.ini, the argos widget,
# stream-profiles-edit and stream-reset when they are missing — after
# `--all`, run stream-window once and everything is back.

set -u
RTD="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

echo "[1/5] stopping running streams"
[ -f "$RTD/stream-window.pid" ] && kill "$(cat "$RTD/stream-window.pid")" 2>/dev/null
# leftovers that outlived their pidfile: orchestrators carry the pidfile
# path in argv, gst children carry 'pipewiresrc'
pkill -f 'stream-window\.pid' 2>/dev/null
pkill -f 'pipewiresrc' 2>/dev/null
sleep 1

echo "[2/5] removing runtime files"
rm -f "$RTD/stream-window.pid" "$RTD/stream-window.state" \
      "$HOME/stream-window.log"

echo "[3/5] removing portal persist token + permission entry"
rm -f "$HOME/.local/share/stream-window.token" \
      "$HOME/.local/share/flatpak/db/screencast"

echo "[4/5] restarting portal daemons (clears in-memory persist)"
pkill -f xdg-permission-store 2>/dev/null
pkill -f xdg-desktop-portal 2>/dev/null
sleep 1

if [ "${1:-}" = "--all" ]; then
    echo "[5/5] removing installed files"
    rm -rf "$HOME/.config/stream-window"
    rm -f "$HOME/.config/argos/stream.r.2s.sh"
    rm -f "$HOME/.local/bin/stream-window" "$HOME/.local/bin/stream-profiles-edit"
    rm -f "$HOME/.local/bin/stream-reset"
    echo "done — full uninstall complete"
else
    echo "[5/5] done — fresh-machine state; script/config/widget kept"
fi
RESET_EOF
    chmod +x "$BIN_DIR/stream-reset"
    echo "installed $BIN_DIR/stream-reset" >&2
fi
# --- end self-install ------------------------------------------------------

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/stream-window.pid"
case "${1:-}" in
    --edit) exec "$BIN_DIR/stream-profiles-edit" ;;
    --version|-V) echo "stream-window $VERSION"; exit 0 ;;
esac
case "${1:-}" in
    ""|-h|--help|--list) ;;          # python handles these
    *)
        if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            cur=$(tr '\0' '\n' < "/proc/$(cat "$PIDFILE")/cmdline" 2>/dev/null | tail -1)
            echo "already running (pid $(cat "$PIDFILE")) — stop with: kill \$(cat $PIDFILE)" >&2
            gdbus call --session --dest org.freedesktop.Notifications \
                --object-path /org/freedesktop/Notifications \
                --method org.freedesktop.Notifications.Notify \
                "stream-window" 0 "dialog-warning" "stream-window" \
                "not started — '${cur:-?}' is already running" "[]" "{}" 8000 \
                >/dev/null 2>&1 || true
            exit 1
        fi
        echo $$ > "$PIDFILE"
        ;;
esac

exec python3 - "$PIDFILE" "$@" <<'PYEOF'
import configparser
import itertools
import os
import shlex
import signal
import subprocess
import sys
import threading
import time

from gi.repository import Gio, GLib

PIDFILE = sys.argv[1]
ARGS = sys.argv[2:]

PROFILES_FILE = os.path.expanduser(os.environ.get(
    "STREAM_PROFILES", "~/.config/stream-window/profiles.ini"))
TOKEN_FILE = os.path.expanduser("~/.local/share/stream-window.token")
STATE_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                          "stream-window.state")
FPS = 24
KEY_INT = FPS * 2
DEF_BITRATE = 1800            # server doc: recommended <= 2500
DEF_OSD_FONT = "Sans 16"

NAMED_COLORS = {
    "white": "FFFFFFFF", "black": "FF000000", "red": "FFFF0000",
    "green": "FF00FF00", "blue": "FF0000FF", "yellow": "FFFFFF00",
    "cyan": "FF00FFFF", "magenta": "FFFF00FF", "orange": "FFFF8000",
    "gray": "FF808080", "grey": "FF808080", "lightgray": "FFCCCCCC",
    "transparent": "00000000",
}


def parse_color(s):
    """Human color -> gstreamer big-endian ARGB (0xAARRGGBB).

    Accepts: white / #RGB / #RRGGBB / #RRGGBBAA / 0xAARRGGBB."""
    s = s.strip()
    low = s.lower()
    if low in NAMED_COLORS:
        return "0x" + NAMED_COLORS[low]
    if s.startswith("#"):
        h = s[1:]
        if len(h) == 3:
            h = "FF" + "".join(c * 2 for c in h)   # RGB -> opaque
        elif len(h) == 6:
            h = "FF" + h               # RRGGBB -> opaque
        elif len(h) == 8:
            h = h[6:8] + h[:6]         # RRGGBBAA -> AARRGGBB
        if len(h) == 8 and all(c in "0123456789abcdefABCDEF" for c in h):
            return "0x" + h.upper()
    elif low.startswith("0x") and len(s) == 10:
        return s                        # raw AARRGGBB
    sys.exit(f"error: bad color '{s}' (use a name, #RRGGBB[AA], or 0xAARRGGBB)")


def load_profile(name):
    cfg = configparser.ConfigParser()
    if not cfg.read(PROFILES_FILE):
        sys.exit(f"error: '{name}' is not an rtmp(s) URL and no profiles "
                 f"file found at {PROFILES_FILE}")
    if not cfg.has_section(name):
        sys.exit(f"error: no profile '{name}' in {PROFILES_FILE}\n"
                 f"profiles: {', '.join(cfg.sections())}")
    return cfg[name]


if not ARGS or ARGS[0] in ("-h", "--help"):
    sys.exit("usage: stream-window <profile> | <rtmp-url> [x y w h] [kbps] "
             "| --list")

if ARGS[0] == "--list":
    cfg = configparser.ConfigParser()
    cfg.read(PROFILES_FILE)
    if not cfg.sections():
        print(f"no profiles in {PROFILES_FILE}")
    for s in cfg.sections():
        u = cfg[s].get("url", "?")
        host = u.split("//", 1)[-1].split("/", 1)[0]
        print(f"{s:20} {host}")
    sys.exit(0)

# ---- resolve profile or ad-hoc URL -------------------------------------
ENCODER = os.environ.get("ENCODER", "auto")
WATCH_PROC = os.environ.get("WATCH_PROC", "")
REQUIRE_PROC = os.environ.get("REQUIRE_PROC", "")
START_CMD = os.environ.get("START_CMD", "")
TRAILING_SLASH = os.environ.get("RTMP_TRAILING_SLASH", "")

if ARGS[0].startswith(("rtmp://", "rtmps://")):
    PROFILE = "custom"
    RTMP_URL = ARGS[0]
    CROP = ARGS[1:5] if len(ARGS) >= 5 else None
    BITRATE = int(ARGS[5]) if len(ARGS) > 5 else DEF_BITRATE
    OSD = os.environ.get("OSD", "")
    OSD_FONT = os.environ.get("OSD_FONT", DEF_OSD_FONT)
    OSD_COLOR = parse_color(os.environ.get("OSD_COLOR", "#FFFFFF22"))
    OSD_OUTLINE = parse_color(os.environ.get("OSD_OUTLINE", "transparent"))
    OSD_XPAD = os.environ.get("OSD_XPAD", "48")
    OSD_YPAD = os.environ.get("OSD_YPAD", "36")
    OSD_OUTLINE_W = int(os.environ.get("OSD_OUTLINE_WIDTH", "1"))
else:
    PROFILE = ARGS[0]
    p = load_profile(PROFILE)   # [DEFAULT] values apply automatically
    RTMP_URL = p.get("url", "")
    if not RTMP_URL:
        sys.exit(f"error: profile '{PROFILE}' has no 'url' key")
    CROP = p.get("crop", "").split() or None
    BITRATE = int(p.get("bitrate", DEF_BITRATE))
    OSD = PROFILE                    # OSD text is the profile name
    OSD_FONT = p.get("osd_font", DEF_OSD_FONT)
    OSD_COLOR = parse_color(p.get("osd_color", "#FFFFFF22"))
    OSD_OUTLINE = parse_color(p.get("osd_outline", "transparent"))
    OSD_XPAD = p.get("osd_xpad", "48")
    OSD_YPAD = p.get("osd_ypad", "36")
    OSD_OUTLINE_W = int(p.get("osd_outline_width", "1"))
    WATCH_PROC = WATCH_PROC or p.get("watch_proc", "")
    REQUIRE_PROC = REQUIRE_PROC or p.get("require_proc", "")
    START_CMD = START_CMD or p.get("start_cmd", "")
    ENCODER = os.environ.get("ENCODER") or p.get("encoder", "auto")

# some servers require rtmp(s)://{host}/{path}/ (trailing '/'). Never applied
# to URLs containing '?': a trailing '/' would corrupt the last query param.
if TRAILING_SLASH and TRAILING_SLASH not in ("0", "no", "false") \
        and "?" not in RTMP_URL and not RTMP_URL.endswith("/"):
    RTMP_URL += "/"

PORTAL = "org.freedesktop.portal.Desktop"
PORTAL_PATH = "/org/freedesktop/portal/desktop"
SC_IFACE = "org.freedesktop.portal.ScreenCast"
REQ_IFACE = "org.freedesktop.portal.Request"

bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
loop = GLib.MainLoop()
tokens = itertools.count(1)


def have_element(name):
    return subprocess.run(["gst-inspect-1.0", name],
                          stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


def preflight():
    """Fail fast with readable errors on an unprepared system."""
    missing = [e for e in ("pipewiresrc", "flvmux", "rtmp2sink",
                           "avenc_aac", "h264parse", "aacparse",
                           "textoverlay")
               if not have_element(e)]
    if missing:
        sys.exit("error: missing gstreamer elements: " + ", ".join(missing))
    try:
        bus.call_sync(PORTAL, PORTAL_PATH,
                      "org.freedesktop.DBus.Properties", "Get",
                      GLib.Variant("(ss)", (SC_IFACE, "version")),
                      None, Gio.DBusCallFlags.NONE, 5000, None)
    except Exception as e:
        sys.exit(f"error: xdg-desktop-portal ScreenCast unavailable: {e}")
    if not os.environ.get("WAYLAND_DISPLAY"):
        print("warning: WAYLAND_DISPLAY unset — are you in a Wayland session?",
              flush=True)


def call(path, iface, method, variant):
    return bus.call_sync(PORTAL, path, iface, method, variant, None,
                         Gio.DBusCallFlags.NONE, -1, None).unpack()


def portal_call(path, iface, method, sig, args, options):
    """Call a portal method that returns a Request; wait for its Response."""
    done = {}
    tok = f"sr{next(tokens)}"
    options = dict(options)
    options["handle_token"] = GLib.Variant("s", tok)
    full_args = tuple(args) + (options,)
    req_path = [None]

    def on_resp(conn, sender, p, i, s, prm):
        if req_path[0] is not None and p != req_path[0]:
            return
        code, results = prm.unpack()
        done["code"] = code
        done["results"] = results
        loop.quit()

    # subscribe BEFORE calling so we never miss the Response
    sub = bus.signal_subscribe(PORTAL, REQ_IFACE, "Response", None, None,
                             Gio.DBusSignalFlags.NONE, on_resp)
    (rp,) = call(path, iface, method,
                 GLib.Variant(f"({sig}a{{sv}})", full_args))
    req_path[0] = rp
    loop.run()
    bus.signal_unsubscribe(sub)
    if done.get("code") != 0:
        raise RuntimeError(f"{method} failed/cancelled (code {done.get('code')})")
    return done["results"]


def cleanup(*_):
    stopping.set()
    for f in (PIDFILE, STATE_FILE):
        if f:
            try:
                os.unlink(f)
            except OSError:
                pass
    global gst_proc
    if gst_proc:
        gst_proc.terminate()
    loop.quit()


def pick_encoder():
    if ENCODER == "x264":
        return "x264"
    if ENCODER in ("auto", "va"):
        if have_element("vah264lpenc") and os.path.isdir("/run/opengl-driver"):
            return "va"
        if ENCODER == "va":
            print("warning: vah264lpenc/driver unavailable, using x264", flush=True)
    return "x264"


def launch_gst(node_id, crop, win_size):
    global gst_proc
    enc = pick_encoder()
    pl = ["gst-launch-1.0", "-e",
          "flvmux", "name=mux", "streamable=true",
          "!", "rtmp2sink", f"location={RTMP_URL}", "sync=false",
          "pipewiresrc", f"path={node_id}", "do-timestamp=true",
          "!", "videorate", "!", "videoconvert"]
    if crop:
        # videocrop takes margins from each edge
        cx, cy, cw, ch = crop
        ww, wh = win_size
        right = ww - (cx + cw)
        bottom = wh - (cy + ch)
        pl += ["!", "videocrop", f"left={cx}", f"top={cy}",
               f"right={max(right,0)}", f"bottom={max(bottom,0)}"]
    if OSD:
        xp, yp = int(OSD_XPAD), int(OSD_YPAD)
        transparent = OSD_OUTLINE.endswith("00000000")
        if OSD_OUTLINE_W > 0 and not transparent:
            # emulate thick outline: copies of the text in outline color
            # offset by +-W px, drawn underneath the main text
            w = OSD_OUTLINE_W
            for dx, dy in ((-w, -w), (0, -w), (w, -w), (-w, 0),
                           (w, 0), (-w, w), (0, w), (w, w)):
                pl += ["!", "textoverlay", f"text={OSD}",
                       "valignment=top", "halignment=left",
                       f"xpad={max(xp + dx, 0)}", f"ypad={max(yp + dy, 0)}",
                       f"font-desc={OSD_FONT}", "draw-outline=false",
                       f"color={OSD_OUTLINE}", "draw-shadow=false"]
            draw_outline = "false"
        else:
            draw_outline = "false" if transparent else "true"
        pl += ["!", "textoverlay", f"text={OSD}",
               "valignment=top", "halignment=left",
               f"xpad={xp}", f"ypad={yp}",
               f"font-desc={OSD_FONT}",
               f"draw-outline={draw_outline}",
               f"outline-color={OSD_OUTLINE}",
               f"color={OSD_COLOR}", "draw-shadow=true"]
    env = dict(os.environ)
    if enc == "va":
        env["LIBVA_DRIVER_NAME"] = "iHD"
        env["LIBVA_DRIVERS_PATH"] = "/run/opengl-driver/lib/dri"
        pl += ["!", f"video/x-raw,format=NV12,framerate={FPS}/1",
               "!", "vah264lpenc", f"bitrate={BITRATE}",
               "rate-control=cbr", f"key-int-max={KEY_INT}", "b-frames=0",
               "!", "h264parse", "!", "mux."]
    else:
        pl += ["!", f"video/x-raw,format=I420,framerate={FPS}/1",
               "!", "x264enc", "tune=zerolatency", "speed-preset=ultrafast",
               f"bitrate={BITRATE}", f"key-int-max={KEY_INT}", "bframes=0",
               "!", "h264parse", "!", "mux."]
    pl += ["audiotestsrc", "wave=silence", "is-live=true",
           "!", "audioconvert",
           "!", "audio/x-raw,rate=44100,channels=2",
           "!", "avenc_aac", "bitrate=128000",
           "!", "aacparse", "!", "mux."]
    print(f"profile: {PROFILE}  encoder: {enc}  osd: {OSD or '-'}", flush=True)
    print("pipeline:", " ".join(pl), flush=True)
    gst_proc = subprocess.Popen(pl, env=env)

    st = {"streak": 0, "connected": False}

    def mark_running(proc):
        # gst up 4s => tray "STREAM", but only for a clean run (streak==0)
        # or a proven stream (connected) — a retry of a bad profile that
        # stalls mid-connect must not flip the tray on
        deadline = time.time() + 4
        while time.time() < deadline:
            if proc.poll() is not None or stopping.is_set():
                return
            time.sleep(0.2)
        if st["streak"] == 0 or st["connected"]:
            with open(STATE_FILE, "w") as f:
                f.write(PROFILE)
        # gst up 30s total => was really streaming; drops after this are
        # retried forever (internet loss), below this => bad profile
        deadline = time.time() + 26
        while time.time() < deadline:
            if proc.poll() is not None or stopping.is_set():
                return
            time.sleep(0.5)
        if not st["connected"]:
            st["connected"] = True
            with open(STATE_FILE, "w") as f:
                f.write(PROFILE)

    def supervise(proc):
        global gst_proc
        while not stopping.is_set():
            t0 = time.time()
            rc = proc.wait()
            if stopping.is_set():
                return
            # died fast => connection/startup failure streak; ran a while
            # => was streaming, so a fresh failure deserves a new notice
            st["streak"] = st["streak"] + 1 if time.time() - t0 < 30 else 1
            print(f"gst exited (rc={rc}), restarting in 5s", flush=True)
            if st["streak"] == 1:
                notify(f"'{PROFILE}' stream failed",
                       f"gst-launch exited (rc={rc}) — retrying every 5s. "
                       "Check the RTMP URL/server.")
            if st["streak"] == 3:  # sustained outage: tray back to "off"
                try:
                    os.unlink(STATE_FILE)
                except OSError:
                    pass
            if st["streak"] == 2 and not st["connected"]:
                # ~10s of failures, never streamed: bad profile — give up
                # fast so the pidfile doesn't block other profiles
                notify(f"'{PROFILE}' stream failed",
                       "never connected — gave up")
                GLib.idle_add(cleanup)
                return
            time.sleep(5)
            if stopping.is_set():
                return
            gst_proc = subprocess.Popen(pl, env=env)
            proc = gst_proc
            threading.Thread(target=mark_running, args=(proc,),
                             daemon=True).start()

    threading.Thread(target=supervise, args=(gst_proc,), daemon=True).start()
    threading.Thread(target=mark_running, args=(gst_proc,), daemon=True).start()


gst_proc = None
stopping = threading.Event()


def notify(summary, body):
    """Desktop notification — visible even when launched from the tray."""
    try:
        bus.call_sync("org.freedesktop.Notifications",
                      "/org/freedesktop/Notifications",
                      "org.freedesktop.Notifications", "Notify",
                      GLib.Variant("(susssasa{sv}i)",
                                   ("stream-window", 0, "dialog-warning",
                                    summary, body, [], {}, 8000)),
                      None, Gio.DBusCallFlags.NONE, 5000, None)
    except Exception:
        pass


def proc_running():
    return subprocess.run(["pgrep", "-f", REQUIRE_PROC],
                          stdout=subprocess.DEVNULL).returncode == 0


if REQUIRE_PROC and not proc_running() and START_CMD:
    print(f"'{REQUIRE_PROC}' not running — starting: {START_CMD}",
          flush=True)
    subprocess.Popen(shlex.split(START_CMD))
    deadline = time.time() + 15
    while not proc_running() and time.time() < deadline:
        time.sleep(0.5)
    time.sleep(2)                    # give the window a moment to map

if REQUIRE_PROC and not proc_running():
    msg = f"no running process matches '{REQUIRE_PROC}'"
    print(f"warning: {msg} — not starting '{PROFILE}'", flush=True)
    notify(f"'{PROFILE}' not started", msg)
    try:
        os.unlink(PIDFILE)
    except OSError:
        pass
    sys.exit(1)

preflight()

restore_token = None
if os.path.exists(TOKEN_FILE):
    restore_token = open(TOKEN_FILE).read().strip() or None
if not restore_token:
    print("no saved window selection — picker dialog will appear once",
          flush=True)
    print("(select the window, enable 'Remember this selection', Share)",
          flush=True)

# 1. session
res = portal_call(PORTAL_PATH, SC_IFACE, "CreateSession", "", (),
                  {"session_handle_token": GLib.Variant("s", f"sess{next(tokens)}")})
session = res["session_handle"]
print("portal session:", session, flush=True)

# 2. select sources -> window picker dialog (skipped when restore token works)
opts = {"types": GLib.Variant("u", 2),           # 2 = window
        "multiple": GLib.Variant("b", False),
        "persist_mode": GLib.Variant("u", 2),
        "cursor_mode": GLib.Variant("u", 1)}     # hidden cursor
if restore_token:
    opts["restore_token"] = GLib.Variant("s", restore_token)
portal_call(PORTAL_PATH, SC_IFACE, "SelectSources", "o", (session,), opts)

# 3. start
res = portal_call(PORTAL_PATH, SC_IFACE, "Start", "os", (session, ""), {})
streams = res.get("streams", [])
if "restore_token" in res:
    tok = res["restore_token"]
    os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
    open(TOKEN_FILE, "w").write(tok)
    print("saved persist token", flush=True)

if not streams:
    print("no streams returned", flush=True)
    cleanup()
    sys.exit(1)

node_id, props = streams[0]
print(f"node {node_id} props {props}", flush=True)

win_size = tuple(props.get("size", (0, 0)))

crop = None
if CROP:
    crop = [int(v) for v in CROP]
    if win_size == (0, 0):
        print("warning: window size unknown, crop may be wrong", flush=True)

launch_gst(node_id, crop, win_size)

# exit when the watched process disappears (e.g. screenrec tray closed)
if WATCH_PROC:
    def proc_pids():
        out = subprocess.run(["pgrep", "-f", WATCH_PROC],
                             capture_output=True, text=True)
        return out.stdout.split()

    def watch_proc():
        pids = proc_pids()
        if not pids:
            print(f"waiting for '{WATCH_PROC}' to start...", flush=True)
            while not pids and not stopping.wait(2):
                pids = proc_pids()
            if not pids:
                return
            print(f"'{WATCH_PROC}' started (pids {','.join(pids)})",
                  flush=True)
        while not stopping.wait(2):
            if not proc_pids():
                print(f"'{WATCH_PROC}' exited -> stopping stream", flush=True)
                GLib.idle_add(cleanup)
                return

    threading.Thread(target=watch_proc, daemon=True).start()
    print(f"watching '{WATCH_PROC}'", flush=True)

GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, cleanup)
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, cleanup)
loop.run()
PYEOF
