def parse_color(s):
    """Human color -> gstreamer big-endian ARGB (0xAARRGGBB).

    Accepts: white / #RGB / #RRGGBB / #RRGGBBAA / 0xAARRGGBB."""
    s = s.strip()
    low = s.lower()
    if low in NAMED_COLORS:
        return "0x" + NAMED_COLORS[low]
    if s.startswith("#"):
        h = s[1:]
        if len(h) == 3:
            h = "FF" + "".join(c * 2 for c in h)   # RGB -> opaque
        elif len(h) == 6:
            h = "FF" + h               # RRGGBB -> opaque
        elif len(h) == 8:
            h = h[6:8] + h[:6]         # RRGGBBAA -> AARRGGBB
