# stop the stream when a watched process disappears. WATCH_PROC re-matches
# the pattern every poll; REQUIRE_PROC is pinned to the pids alive now —
# the captured window dies with that instance, so an app restart stops the
# stream even though a process by that name is running again
WATCHES = [(REQUIRE_PROC, True)] if REQUIRE_PROC else []
if WATCH_PROC:
    WATCHES.append((WATCH_PROC, False))

def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError):
        return False

def watch_one(pattern, pinned):
    pids = pgrep_filtered(pattern)
    if not pids:
        if pinned:      # require_proc died between the check and now
            print(f"'{pattern}' already gone -> stopping stream", flush=True)
            GLib.idle_add(cleanup)
            return
        print(f"waiting for '{pattern}' to start...", flush=True)
        while not pids and not stopping.wait(2):
            pids = pgrep_filtered(pattern)
        if not pids:
            return
    print(f"watching '{pattern}' (pids {','.join(pids)})"
          + (" pinned" if pinned else ""), flush=True)
    while not stopping.wait(2):
        if pinned:
            pids = [p for p in pids if pid_alive(p)]
            gone = not pids
        else:
            gone = not pgrep_filtered(pattern)
        if gone:
            print(f"'{pattern}' exited -> stopping stream", flush=True)
            GLib.idle_add(cleanup)
            return

for pattern, pinned in WATCHES:
    threading.Thread(target=watch_one, args=(pattern, pinned),
                     daemon=True).start()

GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, cleanup)
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, cleanup)
