    tok = f"sr{next(tokens)}"
    options = dict(options)
    options["handle_token"] = GLib.Variant("s", tok)
    full_args = tuple(args) + (options,)
    req_path = [None]

    def on_resp(conn, sender, p, i, s, prm):
        if req_path[0] is not None and p != req_path[0]:
            return
        code, results = prm.unpack()
        done["code"] = code
        done["results"] = results
        loop.quit()

    # subscribe BEFORE calling so we never miss the Response
    sub = bus.signal_subscribe(PORTAL, REQ_IFACE, "Response", None, None,
                             Gio.DBusSignalFlags.NONE, on_resp)
    (rp,) = call(path, iface, method,
                 GLib.Variant(f"({sig}a{{sv}})", full_args))
    req_path[0] = rp
    loop.run()
    bus.signal_unsubscribe(sub)
    if done.get("code") != 0:
        raise RuntimeError(f"{method} failed/cancelled (code {done.get('code')})")
    return done["results"]


def cleanup(*_):
    stopping.set()
    for f in (PIDFILE, STATE_FILE):
        if f:
            try:
                os.unlink(f)
            except OSError:
                pass
    global gst_proc
    if gst_proc:
        gst_proc.terminate()
    loop.quit()


def pick_encoder():
    if ENCODER == "x264":
        return "x264"
    if ENCODER in ("auto", "va"):
        if have_element("vah264lpenc") and os.path.isdir("/run/opengl-driver"):
            return "va"
        if ENCODER == "va":
            print("warning: vah264lpenc/driver unavailable, using x264", flush=True)
    return "x264"


def launch_gst(node_id, crop, win_size):
    global gst_proc
    enc = pick_encoder()
    # cheapest-first order: videorate drops to FPS early, then crop and
    # scale shrink the frame before videoconvert/OSD/encoder touch it
    pl = ["gst-launch-1.0", "-e",
          "flvmux", "name=mux", "streamable=true",
          "!", "rtmp2sink", f"location={RTMP_URL}", "sync=false",
          "pipewiresrc", f"path={node_id}", "do-timestamp=true",
          "!", "videorate"]
    if crop:
        # videocrop takes margins from each edge
        cx, cy, cw, ch = crop
        ww, wh = win_size
        right = ww - (cx + cw)
        bottom = wh - (cy + ch)
        pl += ["!", "videocrop", f"left={cx}", f"top={cy}",
               f"right={max(right,0)}", f"bottom={max(bottom,0)}"]
    # scale into the fit-box after crop but before OSD, so text is drawn
    # once at the smaller output size (cheaper overlays + encoder input)
    out_w, out_h = (crop[2], crop[3]) if crop else win_size
    if SCALE:
        out_w, out_h = fit_size(out_w, out_h, *SCALE)
        pl += ["!", "videoscale", "method=lanczos", "!",
               f"video/x-raw,width={out_w},height={out_h}"]
    pl += ["!", "videoconvert"]
    if OSD:
        xp, yp = int(OSD_XPAD), int(OSD_YPAD)
        if out_w and out_h and (xp >= out_w or yp >= out_h):
            print(f"warning: osd padding {xp},{yp} >= frame {out_w}x{out_h}"
                  " — text may be off-screen", flush=True)
        transparent = OSD_OUTLINE.endswith("00000000")
        if OSD_OUTLINE_W > 0 and not transparent:
            # emulate thick outline: copies of the text in outline color
            # offset by +-W px, drawn underneath the main text
            w = OSD_OUTLINE_W
            for dx, dy in ((-w, -w), (0, -w), (w, -w), (-w, 0),
                           (w, 0), (-w, w), (0, w), (w, w)):
                pl += ["!", "textoverlay", f"text={OSD}",
                       "valignment=top", "halignment=left",
                       f"xpad={max(xp + dx, 0)}", f"ypad={max(yp + dy, 0)}",
                       f"font-desc={OSD_FONT}", "draw-outline=false",
                       f"color={OSD_OUTLINE}", "draw-shadow=false"]
            draw_outline = "false"
        else:
            draw_outline = "false" if transparent else "true"
        pl += ["!", "textoverlay", f"text={OSD}",
               "valignment=top", "halignment=left",
               f"xpad={xp}", f"ypad={yp}",
               f"font-desc={OSD_FONT}",
               f"draw-outline={draw_outline}",
               f"outline-color={OSD_OUTLINE}",
               f"color={OSD_COLOR}", "draw-shadow=true"]
    env = dict(os.environ)
    if enc == "va":
        env["LIBVA_DRIVER_NAME"] = "iHD"
        env["LIBVA_DRIVERS_PATH"] = "/run/opengl-driver/lib/dri"
        pl += ["!", f"video/x-raw,format=NV12,framerate={FPS}/1",
               "!", "vah264lpenc", f"bitrate={BITRATE}",
               "rate-control=cbr", f"key-int-max={KEY_INT}", "b-frames=0",
               "!", "h264parse", "!", "mux."]
    else:
        pl += ["!", f"video/x-raw,format=I420,framerate={FPS}/1",
               "!", "x264enc", "tune=zerolatency", "speed-preset=veryfast",
               f"bitrate={BITRATE}", f"key-int-max={KEY_INT}", "bframes=0",
               "!", "h264parse", "!", "mux."]
    pl += ["audiotestsrc", "wave=silence", "is-live=true",
           "!", "audioconvert",
           "!", "audio/x-raw,rate=44100,channels=1",
           "!", "avenc_aac", "bitrate=64000",
           "!", "aacparse", "!", "mux."]
    print(f"profile: {PROFILE}  encoder: {enc}  osd: {OSD or '-'}  "
          f"out: {out_w or '?'}x{out_h or '?'}@{FPS}fps", flush=True)
    print("pipeline:", " ".join(pl), flush=True)
    gst_proc = subprocess.Popen(pl, env=env)

    st = {"streak": 0, "connected": False}

    def mark_running(proc):
        # gst up 4s => tray "STREAM", but only for a clean run (streak==0)
        # or a proven stream (connected) — a retry of a bad profile that
        # stalls mid-connect must not flip the tray on
        deadline = time.time() + 4
        while time.time() < deadline:
            if proc.poll() is not None or stopping.is_set():
                return
            time.sleep(0.2)
        if st["streak"] == 0 or st["connected"]:
            with open(STATE_FILE, "w") as f:
                f.write(PROFILE)
        # gst up 30s total => was really streaming; drops after this are
        # retried forever (internet loss), below this => bad profile
        deadline = time.time() + 26
        while time.time() < deadline:
            if proc.poll() is not None or stopping.is_set():
                return
            time.sleep(0.5)
        if not st["connected"]:
            st["connected"] = True
            with open(STATE_FILE, "w") as f:
                f.write(PROFILE)

    def supervise(proc):
        global gst_proc
        while not stopping.is_set():
            t0 = time.time()
            rc = proc.wait()
            if stopping.is_set():
                return
            # died fast => connection/startup failure streak; ran a while
            # => was streaming, so a fresh failure deserves a new notice
            st["streak"] = st["streak"] + 1 if time.time() - t0 < 30 else 1
            print(f"gst exited (rc={rc}), restarting in 5s", flush=True)
            if st["streak"] == 1:
                notify(tr("notify_fail", PROFILE), tr("fail_body", rc))
            if st["streak"] == 3:  # sustained outage: tray back to "off"
                try:
                    os.unlink(STATE_FILE)
                except OSError:
                    pass
            if st["streak"] == 2 and not st["connected"]:
                # ~10s of failures, never streamed: bad profile — give up
                # fast so the pidfile doesn't block other profiles
                notify(tr("notify_fail", PROFILE), tr("gaveup_body"))
                GLib.idle_add(cleanup)
                return
            time.sleep(5)
            if stopping.is_set():
                return
            gst_proc = subprocess.Popen(pl, env=env)
            proc = gst_proc
            threading.Thread(target=mark_running, args=(proc,),
                             daemon=True).start()

    threading.Thread(target=supervise, args=(gst_proc,), daemon=True).start()
    threading.Thread(target=mark_running, args=(gst_proc,), daemon=True).start()


gst_proc = None
stopping = threading.Event()


def notify(summary, body):
    """Desktop notification — visible even when launched from the tray."""
    try:
        bus.call_sync("org.freedesktop.Notifications",
                      "/org/freedesktop/Notifications",
                      "org.freedesktop.Notifications", "Notify",
                      GLib.Variant("(susssasa{sv}i)",
                                   ("stream-window", 0, "dialog-warning",
                                    summary, body, [], {}, 8000)),
                      None, Gio.DBusCallFlags.NONE, 5000, None)
    except Exception:
        pass


def pgrep_filtered(pattern):
    """pgrep -f <pattern> minus our own processes: the orchestrator argv
    carries the profile name and gst children carry the OSD text in argv,
    so an unfiltered match would pin the watch to ourselves."""
    out = subprocess.run(["pgrep", "-f", pattern],
                         capture_output=True, text=True)
    mine = {os.getpid(), os.getppid()}
    if gst_proc and gst_proc.poll() is None:
        mine.add(gst_proc.pid)
    pids = []
    for p in out.stdout.split():
        try:
            pid = int(p)
        except ValueError:
            continue
        if pid in mine:
            continue
        try:
            if b"stream-window" in open(f"/proc/{pid}/cmdline", "rb").read():
                continue
        except OSError:
            continue
        pids.append(p)
    return pids


def proc_running():
    return bool(pgrep_filtered(REQUIRE_PROC))


if REQUIRE_PROC and not proc_running() and START_CMD:
