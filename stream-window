#!/usr/bin/env bash
# stream-reset — restore the machine to "before stream-window ever ran",
# so first-run behavior (deps download, picker dialog, token persist) can
# be re-tested.
#
# Run with no arguments for an interactive menu. Flags (for scripts):
#   --reset            reset runtime + portal state only (config kept)
#   --all              full uninstall; profiles.ini is backed up first to
#                      ~/.config/stream-window.profiles.ini.bak
#   --keep-profiles    with --all: profiles.ini is kept in place instead
#   -i, --interactive  force the interactive menu
#   -y, --yes          skip the confirmation prompt
#
# Every mode asks for a typed 'yes' confirmation on a terminal; without a
# terminal it refuses to run unless --yes is given.
#
# UI language: STREAM_LANG env > ~/.config/stream-window/lang > uk
#
# Currently covers state created by stream-window:
#   - running stream processes and their gst children
#   - $XDG_RUNTIME_DIR/stream-window.{pid,state}
#   - ~/.local/share/stream-window.token  (portal persist handle)
#   - ~/.local/share/flatpak/db/screencast (portal permission store entry)
#   - portal daemons restarted (they cache persist tokens in memory)
#   - ~/stream-window.log
#
# NOT covered: nix store caches (deps stay downloaded — harmless, a truly
# fresh machine downloads them once anyway) and the Devin Desktop install
# (~/.local/bin/devin-desktop, ~/.local/share/devin-desktop-libs,
# ~/.local/share/applications/devin-desktop.desktop) which is unrelated.
#
# Note: stream-window reinstalls/updates profiles.ini, the argos widget,
# stream-profiles-edit and stream-reset on every run — after `--all`,
# run stream-window once and everything is back.

set -u
RTD="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
CFG_DIR="$HOME/.config/stream-window"
INI="$CFG_DIR/profiles.ini"
BAK="$HOME/.config/stream-window.profiles.ini.bak"

L="${STREAM_LANG:-$(cat "$CFG_DIR/lang" 2>/dev/null)}"
[ "$L" = en ] || L="uk"

t() {
    local key="$1" s=""
    shift
    case "$L:$key" in
        en:cancelled)  s='cancelled' ;;
        uk:cancelled)  s='скасовано' ;;
        en:confirm)    s="type 'yes' to continue" ;;
        uk:confirm)    s="введіть 'yes' для продовження" ;;
        en:what_reset) s='reset stream state — runtime files + portal state cleared (config kept)' ;;
        uk:what_reset) s='скидання стану стріму — runtime-файли та стан порталу буде очищено (конфіг лишиться)' ;;
        en:what_keep)  s='FULL UNINSTALL — installed files removed, %s kept' ;;
        uk:what_keep)  s='ПОВНЕ ВИДАЛЕННЯ — встановлені файли видалено, %s лишиться' ;;
        en:what_bak)   s='FULL UNINSTALL — profiles backed up to %s' ;;
        uk:what_bak)   s='ПОВНЕ ВИДАЛЕННЯ — профілі збережено в %s' ;;
        en:no_tty)     s='requires confirmation — re-run on a terminal or add --yes' ;;
        uk:no_tty)     s='потрібне підтвердження — запустіть у терміналі або додайте --yes' ;;
        en:unknown)    s='unknown option: %s' ;;
        uk:unknown)    s='невідома опція: %s' ;;
        en:error)      s='error' ;;
        uk:error)      s='помилка' ;;
        en:s1) s='stopping running streams' ;;
        uk:s1) s='зупиняю запущені стріми' ;;
        en:s2) s='removing runtime files' ;;
        uk:s2) s='видаляю runtime-файли' ;;
        en:s3) s='removing portal persist token + permission entry' ;;
        uk:s3) s='видаляю persist-токен порталу + запис дозволу' ;;
        en:s4) s='restarting portal daemons (clears in-memory persist)' ;;
        uk:s4) s="перезапускаю демони порталу (очищає persist у пам'яті)" ;;
        en:s5) s='removing installed files' ;;
        uk:s5) s='видаляю встановлені файли' ;;
        en:backed)    s='profiles backed up to %s' ;;
        uk:backed)    s='профілі збережено в %s' ;;
        en:kept)      s='kept %s' ;;
        uk:kept)      s='лишено %s' ;;
        en:done_all)  s='done — full uninstall complete' ;;
        uk:done_all)  s='готово — повне видалення завершено' ;;
        en:done_soft) s='done — fresh-machine state; script/config/widget kept' ;;
        uk:done_soft) s='готово — стан чистої машини; скрипт/конфіг/віджет лишились' ;;
