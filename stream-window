    for ext in $(gnome-extensions list 2>/dev/null | grep -i argos); do
        gnome-extensions disable "$ext" 2>/dev/null
        gnome-extensions enable "$ext" 2>/dev/null
    done
    t done_all
else
    echo "[5/5] $(t done_soft)"
fi
RESET_EOF
# --- end self-install ------------------------------------------------------

PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/stream-window.pid"
case "${1:-}" in
    --edit) exec "$BIN_DIR/stream-profiles-edit" ;;
    --version|-V) echo "stream-window $VERSION"; exit 0 ;;
esac
case "${1:-}" in
    ""|-h|--help|--list) ;;          # python handles these
    *)
        if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            cur=$(tr '\0' '\n' < "/proc/$(cat "$PIDFILE")/cmdline" 2>/dev/null | tail -1)
