#!/usr/bin/env nix-shell
#!nix-shell -i bash -p "python3.withPackages (ps: [ ps.pygobject3 ])" gobject-introspection glib gst_all_1.gstreamer gst_all_1.gst-plugins-base gst_all_1.gst-plugins-good gst_all_1.gst-plugins-bad gst_all_1.gst-plugins-ugly pipewire glib-networking
#
# Stream a specific window to RTMP(S) on GNOME/Wayland via the xdg-desktop-portal
# ScreenCast API (shows a picker dialog once; selection is persisted).
#
# Usage:
#   stream-window <profile>                    use ~/.config/stream-window/profiles.ini
#                                              (profile name may contain spaces —
#                                              it is drawn as the OSD text)
#   stream-window "<profile name>"             same, when the name has spaces
#   stream-window <rtmp-url> [x y w h] [kbps]  ad-hoc stream
#   stream-window --list                       list configured profiles
#   stream-window --edit                       open the GTK profile editor
#   stream-window --version                    print version
#
# Self-contained: on every run the support files are (re)installed into
# ~/.local/bin and ~/.config and updated when their content differs —
# the argos tray widget, the GTK profile editor and stream-reset. The
# profiles.ini template is only created when missing — it is user config
# and is never overwritten. A curl-downloaded copy of this file is all
# a fresh machine needs.
#
# Profile keys (ini): url, osd_font, osd_color, osd_outline,
#   osd_outline_width, osd_xpad, osd_ypad, crop, scale, fps,
#   bitrate, trailing_slash, watch_proc, require_proc, start_cmd,
#   encoder.
#   The OSD text is the profile name (spaces allowed).
#   Colors: names (white/black/...), #RGB, #RRGGBB, #RRGGBBAA,
#   or raw 0xAARRGGBB.  A [DEFAULT] section supplies values to all
#   profiles; a profile key overrides its [DEFAULT] counterpart.
#
# Env vars (override profile settings):
#   ENCODER=auto|va|x264   hardware VAAPI encoder (auto = va if available)
#   WATCH_PROC=pattern     exit when no process matches this pgrep -f ERE
#                          pattern; waits for it to appear if absent.
#                          Example: 'screenrec$' watches the tray app while
#                          ignoring the 'screenrec --card ...' daemon.
#   REQUIRE_PROC=pattern   refuse to start unless a process matching this
#                          pgrep -f ERE pattern is running; warns via a
#                          desktop notification (visible from tray
#                          launches). While streaming, the pids seen at
#                          start are watched — when they die (the app was
#                          closed, or restarted under a new pid) the
#                          stream stops.
#   START_CMD=command      if REQUIRE_PROC isn't running, run this first and
#                          wait up to 15s for the process to appear
#   RTMP_TRAILING_SLASH=0  disable the '/' suffix (default: on — the
#                          server requires it; never applied to '?' URLs)
#   OSD=text OSD_FONT=... OSD_COLOR=0xAARRGGBB OSD_OUTLINE=0x...
#   OSD_XPAD=px OSD_YPAD=px   overlay settings for ad-hoc (URL) mode
#   FPS=n SCALE="W H"|off     framerate and fit-box for ad-hoc mode
#
# First run on a fresh machine: the nix-shell shebang downloads all
# dependencies automatically, and the portal picker dialog appears ONCE --
# select the window, tick "Remember this selection", click Share. The
# persist token is saved to ~/.local/share/stream-window.token and all
# later runs skip the dialog entirely.
#
# Server-doc defaults: 1800 kbps (<= 2500 max), 24 fps, scaled to fit
# 1280x720, x264 veryfast, GOP = 2*fps, bframes=0, rtmp2sink, '/'.
#
# Tray: while streaming, ~/.config/argos/stream.r.2s.sh shows the active
# profile from $XDG_RUNTIME_DIR/stream-window.state.
#
# Stop: kill $(cat /run/user/1000/stream-window.pid)

VERSION="0.1.4"

set -euo pipefail

# --- self-install support files (updated when content differs) ----------
BIN_DIR="$HOME/.local/bin"
CFG_DIR="$HOME/.config/stream-window"
mkdir -p "$BIN_DIR" "$CFG_DIR"

# UI language: STREAM_LANG env > ~/.config/stream-window/lang > uk
L="${STREAM_LANG:-$(cat "$CFG_DIR/lang" 2>/dev/null || true)}"
[ "$L" = en ] || L="uk"
t() {
    local key="$1" s=""
    shift
    case "$L:$key" in
        en:running)     s="already running (pid %s) — stop with: kill \$(cat %s)" ;;
        uk:running)     s="вже працює (pid %s) — зупинити: kill \$(cat %s)" ;;
        en:not_started) s="not started — '%s' is already running" ;;
        uk:not_started) s="не запущено — '%s' вже працює" ;;
    esac
    if [ $# -gt 0 ]; then printf "$s\n" "$@"; else printf '%s\n' "$s"; fi
}

# install_file <dst> [exec] — write stdin to dst when missing or different
install_file() {
    local dst="$1" tmp
    tmp=$(mktemp) || return 1
    cat > "$tmp"
    if [ -f "$dst" ] && cmp -s "$tmp" "$dst"; then
        rm -f "$tmp"
        return 0
    fi
    if [ "${2:-}" = exec ]; then chmod +x "$tmp"; fi
    mv "$tmp" "$dst"
    echo "installed/updated $dst" >&2
}

# profiles.ini is user config — created once, never overwritten
if [ ! -f "$CFG_DIR/profiles.ini" ]; then
    install_file "$CFG_DIR/profiles.ini" <<'INI_EOF'
# stream-window profiles — one [section] per profile.
#
# [DEFAULT] is not a profile: its values apply to every profile, and any
# profile can override them by setting the same key.
#
# Keys:
#   url            (required per profile) rtmp(s):// publish URL
#   OSD text       the profile name itself (spaces allowed)
#   osd_font       Pango font (default: Sans 16)
#   osd_color      text color (default: #FFFFFF22)
#   osd_outline    outline color (default: transparent = disabled)
#   osd_outline_width  outline thickness px (default: 1)
#   osd_xpad / osd_ypad  text padding px (default: 48 / 36)
#   crop           "x y w h" relative to window top-left
#   scale          fit video into "W H" box, aspect kept, no upscale
#                  (default: 1280 720; 'off' streams the cropped size)
#   fps            frames per second (default: 24, server max)
#   bitrate        kbps, recommended <= 2500 (default: 1800)
#   trailing_slash append '/' to url (default: 1 — server requires it;
#                  never applied to '?' URLs)
#   watch_proc     pgrep -f ERE pattern; stream exits when nothing matches
#   require_proc   pgrep -f ERE pattern; warn + don't start if absent,
#                  stream stops when that instance dies (app restart too)
#   start_cmd      run this when require_proc is absent; wait ~15s for it
#   encoder        auto | va | x264
#
# colors: white black red green blue yellow cyan magenta orange gray
#         lightgray transparent | #RGB | #RRGGBB | #RRGGBBAA | 0xAARRGGBB
#
# Usage:  stream-window <profile>     (quote names containing spaces)
#         stream-window --list
#         stream-window --edit  (GUI editor)

[DEFAULT]
crop = 1150 220 2686 1938
scale = 1280 720
fps = 24
bitrate = 1800
trailing_slash = 1
watch_proc = screenrec$
require_proc = themis
start_cmd = themis
encoder = auto
osd_font = Sans 16
osd_color = #FFFFFF55
osd_outline = transparent
osd_outline_width = 1
osd_xpad = 48
osd_ypad = 32

# Add profiles below — one [section] each (name = OSD text):
# [my stream]
# url = rtmps://host/app/STREAM_KEY
INI_EOF
fi

ARGOS="$HOME/.config/argos/stream.r.2s.sh"
if [ -d "$HOME/.config/argos" ]; then
    install_file "$ARGOS" exec <<'ARGOS_EOF'
#!/bin/sh
# Argos widget: shows which stream-window profile is streaming.
# stream-window writes the active profile to $XDG_RUNTIME_DIR/stream-window.state
#
# UI language: STREAM_LANG env > ~/.config/stream-window/lang > uk
# The "Language" menu item toggles the file; refresh re-renders the menu.

RTD="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
STATE="$RTD/stream-window.state"
PROFILES="${STREAM_PROFILES:-$HOME/.config/stream-window/profiles.ini}"
EDIT="$HOME/.local/bin/stream-profiles-edit"
RST="$HOME/.local/bin/stream-reset"
LANG_FILE="$HOME/.config/stream-window/lang"
VER=$(sed -n 's/^VERSION="\(.*\)"/\1/p' "$HOME/.local/bin/stream-window" 2>/dev/null | head -1)

L="${STREAM_LANG:-$(cat "$LANG_FILE" 2>/dev/null)}"
[ "$L" = "en" ] || L="uk"

t() {
    case "$L:$1" in
        en:streaming) echo "● STREAM" ;;
        uk:streaming) echo "● СТРІМ" ;;
        en:stop)      echo "Stop stream" ;;
        uk:stop)      echo "Зупинити стрім" ;;
        en:off)       echo "stream: off" ;;
        uk:off)       echo "стрім: вимк" ;;
        en:start)     echo "Start" ;;
        uk:start)     echo "Запустити" ;;
        en:noprof)    echo "no profiles.ini" ;;
        uk:noprof)    echo "немає profiles.ini" ;;
        en:edit)      echo "Edit profiles…" ;;
        uk:edit)      echo "Редагувати профілі…" ;;
        en:update)    echo "Update version…" ;;
        uk:update)    echo "Оновити версію…" ;;
        en:resetmenu) echo "reset / uninstall" ;;
        uk:resetmenu) echo "скидання / видалення" ;;
        en:r_reset)   echo "Reset stream state…" ;;
        uk:r_reset)   echo "Скинути стан стріму…" ;;
        en:r_backup)  echo "Uninstall (backup profiles)…" ;;
        uk:r_backup)  echo "Видалити (бекап профілів)…" ;;
        en:r_keep)    echo "Uninstall (keep profiles)…" ;;
        uk:r_keep)    echo "Видалити (лишити профілі)…" ;;
        en:lang)      echo "Language: English" ;;
        uk:lang)      echo "Мова: Українська" ;;
    esac
}

if [ -s "$STATE" ]; then
    echo "$(t streaming): $(cat "$STATE") | color=#ff3333 font=monospace"
    echo "---"
    echo "$(t stop) | bash='kill \$(cat $RTD/stream-window.pid)' terminal=false refresh=true"
else
    echo "$(t off) | color=#888888 font=monospace"
    echo "---"
    if [ -f "$PROFILES" ]; then
        grep -oE '^\[[^]]+\]' "$PROFILES" | tr -d '[]' | grep -vxF 'DEFAULT' | while read -r p; do
            echo "$(t start): $p | bash='$HOME/.local/bin/stream-window \"$p\"' terminal=false refresh=true"
        done
    else
        echo "$(t noprof) | color=#888888"
    fi
fi
[ -x "$EDIT" ] && echo "$(t edit) | bash='$EDIT' terminal=false"
# the same one-liner as in README "Install": fetch latest stream-window,
# chmod, run it once — self-install then updates all helper files
echo "$(t update) | bash='curl -L --create-dirs -o $HOME/.local/bin/stream-window \"https://raw.githubusercontent.com/gruz/strumok/master/stream-window?v=\$(date +%s)\" && chmod +x $HOME/.local/bin/stream-window && $HOME/.local/bin/stream-window --list' terminal=true refresh=true"
if [ -x "$RST" ]; then
    echo "---"
    # top-level, not '--' nested: the 2s refresh rebuilds the menu and
    # collapses expanded submenus — nested items are unusable
    echo "$(t r_reset) | bash='$RST --reset' terminal=true refresh=true size=10 color=#888888"
    echo "$(t r_backup) | bash='$RST --all' terminal=true refresh=true size=10 color=#888888"
    echo "$(t r_keep) | bash='$RST --all --keep-profiles' terminal=true refresh=true size=10 color=#888888"
fi
CFG_DIR=$(dirname "$LANG_FILE")
if [ "$L" = uk ]; then
    echo "$(t lang) → English | bash='mkdir -p \"$CFG_DIR\" && echo en > \"$LANG_FILE\"' terminal=false refresh=true"
else
    echo "$(t lang) → Українська | bash='mkdir -p \"$CFG_DIR\" && echo uk > \"$LANG_FILE\"' terminal=false refresh=true"
fi
[ -n "$VER" ] && echo "stream-window v$VER | font=monospace size=10 color=#888888 href=https://github.com/gruz/strumok"
exit 0
ARGOS_EOF
else
    echo "note: argos gnome extension not found — tray widget skipped" >&2
fi

install_file "$BIN_DIR/stream-profiles-edit" exec <<'EDIT_EOF'
#!/usr/bin/env nix-shell
#!nix-shell -i bash -p "python3.withPackages (ps: [ ps.pygobject3 ])" gobject-introspection gtk3 glib
#
# stream-profiles-edit — GTK editor for ~/.config/stream-window/profiles.ini
# Self-installed by stream-window on first run.

set -euo pipefail
exec python3 - <<'PYEOF'
import configparser
import os
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gio, Gtk

INI = os.path.expanduser(os.environ.get(
    "STREAM_PROFILES", "~/.config/stream-window/profiles.ini"))

# UI language: STREAM_LANG env > ~/.config/stream-window/lang > uk
_lang = os.environ.get("STREAM_LANG", "")
if _lang not in ("uk", "en"):
    try:
        _lang = open(os.path.expanduser(
            "~/.config/stream-window/lang")).read().strip()
    except OSError:
        _lang = ""
LANG = _lang if _lang in ("uk", "en") else "uk"

T = {
    "title":       ("Stream profiles", "Профілі стріму"),
    "name":        ("Name", "Назва"),
    "url":         ("RTMP URL", "RTMP URL"),
    "name_hint":   ("(name is drawn as the OSD text)",
                    "(назва малюється як текст OSD)"),
    "name_ph":     ("profile name = OSD text", "назва профілю = текст OSD"),
    "advanced":    ("Advanced", "Додатково"),
    "add":         ("Add", "Додати"),
    "delete":      ("Delete", "Видалити"),
    "defaults":    ("Defaults…", "Спільні…"),
    "defaults_tt": ("Edit shared [DEFAULT] values",
                    "Спільні значення [DEFAULT]"),
    "save":        ("Save", "Зберегти"),
    "save_close":  ("Save and close", "Зберегти й закрити"),
    "saved":       ("saved %s", "збережено %s"),
    "def_name":    ("DEFAULT (shared)", "DEFAULT (спільні)"),
    "osd_font":    ("OSD font", "Шрифт OSD"),
    "osd_color":   ("OSD color", "Колір OSD"),
    "osd_outline": ("OSD outline", "Обведення OSD"),
    "osd_outline_width": ("OSD outline width", "Товщина обведення"),
    "osd_xpad":    ("OSD xpad", "OSD xpad"),
    "osd_ypad":    ("OSD ypad", "OSD ypad"),
    "crop":        ("Crop (x y w h)", "Кроп (x y w h)"),
    "scale":       ("Scale box (W H)", "Скейл (W H)"),
    "fps":         ("FPS", "FPS"),
    "bitrate":     ("Bitrate kbps", "Бітрейт kbps"),
    "trailing_slash": ("Trailing '/' on URL", "'/' вкінці URL"),
    "watch_proc":  ("Watch process", "Стежити за процесом"),
    "require_proc": ("Require process", "Вимагати процес"),
    "start_cmd":   ("Start command", "Команда запуску"),
    "encoder":     ("Encoder", "Енкодер"),
}


def tr(key, *args):
    pair = T[key]
    s = pair[0] if LANG == "en" else pair[1]
    return s % args if args else s

HEADER = """# stream-window profiles — one [section] per profile.
#
# [DEFAULT] is not a profile: its values apply to every profile, and any
# profile can override them by setting the same key.
#
# Keys:
#   url            (required per profile) rtmp(s):// publish URL
#   osd            text drawn on the stream (default: profile name in CAPS)
#   osd_font       Pango font (default: Sans 16)
#   osd_color      text color (default: #FFFFFF22)
#   osd_outline    outline color (default: transparent = disabled)
#   osd_outline_width  outline thickness px (default: 1)
#   osd_xpad / osd_ypad  text padding px (default: 48 / 36)
#   crop           "x y w h" relative to window top-left
#   scale          fit video into "W H" box, aspect kept, no upscale
#                  (default: 1280 720; 'off' streams the cropped size)
#   fps            frames per second (default: 24, server max)
#   bitrate        kbps, recommended <= 2500 (default: 1800)
#   trailing_slash append '/' to url (default: 1 — server requires it;
#                  never applied to '?' URLs)
#   watch_proc     pgrep -f ERE pattern; stream exits when nothing matches
#   require_proc   pgrep -f ERE pattern; warn + don't start if absent,
#                  stream stops when that instance dies (app restart too)
#   start_cmd      run this when require_proc is absent; wait ~15s for it
#   encoder        auto | va | x264
#
# colors: white black red green blue yellow cyan magenta orange gray
#         lightgray transparent | #RGB | #RRGGBB | #RRGGBBAA | 0xAARRGGBB
"""

ADV_KEYS = ["osd_font", "osd_color", "osd_outline", "osd_outline_width",
            "osd_xpad", "osd_ypad", "crop", "scale", "fps", "bitrate",
            "trailing_slash", "watch_proc", "require_proc", "start_cmd",
            "encoder"]
FIELDS = ["url"] + ADV_KEYS


class Editor(Gtk.ApplicationWindow):
    def __init__(self, **kwargs):
        super().__init__(title=tr("title"), **kwargs)
        self.set_default_size(920, 460)
        self.set_border_width(8)
        self.dirty = False
        self.current = None

        cfg = configparser.ConfigParser()
        cfg.optionxform = str
        cfg.read(INI)
        self.data = {"DEFAULT": dict(cfg.defaults())}
        for s in cfg.sections():
            self.data[s] = dict(cfg[s])

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.add(paned)

        # left: profile list
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.set_border_width(6)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-selected", self.on_select)
        scroll = Gtk.ScrolledWindow()
        scroll.set_size_request(160, -1)
        scroll.add(self.listbox)
        left.pack_start(scroll, True, True, 0)

        btnbox = Gtk.Box(spacing=6)
        badd = Gtk.Button(label=tr("add"))
        badd.connect("clicked", self.on_add)
        bdel = Gtk.Button(label=tr("delete"))
        bdel.connect("clicked", self.on_del)
        btnbox.pack_start(badd, True, True, 0)
        btnbox.pack_start(bdel, True, True, 0)
        left.pack_start(btnbox, False, False, 0)
        bdef = Gtk.Button(label=tr("defaults"))
        bdef.set_tooltip_text(tr("defaults_tt"))
        bdef.connect("clicked", self.on_defaults)
        left.pack_start(bdef, False, False, 0)
        paned.pack1(left, False, False)

        # right: primary fields (name + url), then Advanced expander
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        right.set_border_width(6)
        self.entries = {}

        top = Gtk.Grid(column_spacing=8, row_spacing=6)
        top.attach(Gtk.Label(label=tr("name"), xalign=0), 0, 0, 1, 1)
        self.name_entry = Gtk.Entry()
        self.name_entry.set_hexpand(True)
        self.name_entry.set_placeholder_text(tr("name_ph"))
        self.name_entry.connect("changed", self.on_rename)
        top.attach(self.name_entry, 1, 0, 1, 1)
        self.url_label = Gtk.Label(label=tr("url"), xalign=0)
        top.attach(self.url_label, 0, 1, 1, 1)
        ue = Gtk.Entry()
        ue.set_hexpand(True)
        ue.connect("changed", self.on_change)
        top.attach(ue, 1, 1, 1, 1)
        self.entries["url"] = ue
        top.attach(Gtk.Label(label=tr("name_hint"),
                             xalign=0), 0, 2, 2, 1)
        right.pack_start(top, False, True, 0)

        self.exp = exp = Gtk.Expander(label=tr("advanced"))
        exp.set_expanded(False)
        grid = Gtk.Grid(column_spacing=8, row_spacing=6)
        grid.set_border_width(4)
        for i, key in enumerate(ADV_KEYS):
            l = Gtk.Label(label=tr(key), xalign=0)
            e = Gtk.Entry()
            e.connect("changed", self.on_change)
            grid.attach(l, 0, i, 1, 1)
            grid.attach(e, 1, i, 1, 1)
            self.entries[key] = e
        exp.add(grid)
        right.pack_start(exp, True, True, 0)

        bbar = Gtk.Box(spacing=6)
        bsave = Gtk.Button(label=tr("save"))
        bsave.get_style_context().add_class("suggested-action")
        bsave.connect("clicked", self.on_save)
        bsavec = Gtk.Button(label=tr("save_close"))
        bsavec.connect("clicked", self.on_save_close)
        bbar.pack_start(bsave, True, True, 0)
        bbar.pack_start(bsavec, True, True, 0)
        right.pack_end(bbar, False, False, 0)
        self.status = Gtk.Label(label="", xalign=0)
        right.pack_end(self.status, False, False, 0)
        paned.pack2(right, True, False)
        self.right = right

        for name in self.data:
            if name != "DEFAULT":
                self.add_row(name)
        self.show_all()
        rows = self.listbox.get_children()
        if rows:
            self.listbox.select_row(rows[0])
        else:
            self.right.hide()

    def add_row(self, name):
        row = Gtk.ListBoxRow()
        row.add(Gtk.Label(label=name, xalign=0))
        row._name = name
        self.listbox.add(row)
        row.show_all()

    def _load(self, name):
        self.current = name
        self.right.show_all()
        vals = self.data.get(name, {})
        for key, e in self.entries.items():
            e.handler_block_by_func(self.on_change)
            e.set_text(str(vals.get(key, "")))
            e.handler_unblock_by_func(self.on_change)
        is_def = name == "DEFAULT"
        self.name_entry.handler_block_by_func(self.on_rename)
        self.name_entry.set_text(tr("def_name") if is_def else name)
        self.name_entry.set_sensitive(not is_def)
        self.name_entry.handler_unblock_by_func(self.on_rename)
        self.url_label.set_visible(not is_def)
        self.entries["url"].set_visible(not is_def)

    def on_select(self, lb, row):
        if row is None:
            return
        self.commit_current()
        self._load(row._name)

    def on_defaults(self, *_):
        self.commit_current()
        self.listbox.unselect_all()
        self._load("DEFAULT")
        self.exp.set_expanded(True)

    def commit_current(self):
        if not self.current:
            return
        vals = {k: e.get_text() for k, e in self.entries.items()
                if e.get_text() != ""}
        self.data[self.current] = vals

    def on_change(self, *_):
        self.commit_current()
        self.dirty = True

    def on_rename(self, entry):
        if not self.current or self.current == "DEFAULT":
            return
        new = entry.get_text().strip()
        if (not new or new == self.current or new in self.data
                or "[" in new or "]" in new or new == "DEFAULT"):
            return
        self.data[new] = self.data.pop(self.current)
        row = self.listbox.get_selected_row()
        row._name = new
        row.get_child().set_text(new)
        self.current = new
        self.dirty = True

    def on_add(self, *_):
        base = "profile"
        i = 1
        while f"{base}{i}" in self.data:
            i += 1
        name = f"{base}{i}"
        self.data[name] = {"url": ""}
        self.add_row(name)
        for r in self.listbox.get_children():
            if r._name == name:
                self.listbox.select_row(r)
        self.dirty = True

    def on_del(self, *_):
        row = self.listbox.get_selected_row()
        if not row or row._name == "DEFAULT":
            return
        del self.data[row._name]
        self.listbox.remove(row)
        self.current = None
        self.right.hide()
        self.dirty = True

    def on_save(self, *_):
        self.commit_current()
        out = [HEADER]
        for name, vals in self.data.items():
            out.append(f"[{name}]")
